describe('xpath locator test',()=>{
    it('should locate elements by using xpath',async()=>{
        await browser.url('https://www.website.com/sign-in/?source=SC&country=IN');
        const username=await $('//input[@id="username"]');
        await username.setValue('mit');

        const password=await $('//input[@id="password"]');
        await password.setValue('mitm');

        const loginBtn=await $('//button[@id="signin-submit2"]');
        await loginBtn.click();

    });
});

